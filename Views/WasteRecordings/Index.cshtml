
@model IEnumerable<CrumbCount2.Models.WasteRecording>

@{
    ViewData["Title"] = "Waste Records";
    var wasteRecords = Model.ToList();
}

<style>
    .waste-page {
        color: #49392F;
    }

    .waste-card {
        background: #FFFFFF;
        border: 1px solid #E4D8C8;
        border-radius: 14px;
        overflow: hidden;
        height: 100%;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .waste-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 6px 18px rgba(73, 57, 47, 0.12);
    }

    .waste-card-header {
        background: #A9B78F;
        padding: 14px 18px;
        color: #49392F;
        font-weight: 600;
    }

    .waste-card-body {
        padding: 20px;
    }

    .waste-product-name {
        font-size: 1.2rem;
        font-weight: 700;
        color: #49392F;
        margin-bottom: 5px;
    }

    .waste-date {
        color: #74665B;
        font-size: 0.9rem;
    }

    .waste-cost {
        font-size: 1.45rem;
        font-weight: 700;
        color: #75563F;
    }

    .waste-info {
        color: #74665B;
        font-size: 0.93rem;
        margin-bottom: 10px;
        overflow-wrap: anywhere;
    }

    .waste-label {
        font-weight: 600;
        color: #49392F;
    }

    .waste-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
        margin-top: 18px;
    }

    .btn-add-waste {
        background: #A9B78F;
        color: #49392F;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        text-decoration: none;
        display: inline-block;
    }

    .btn-add-waste:hover {
        background: #95A77B;
        color: #49392F;
    }

    .btn-waste-edit {
        background: #E5B85C;
        color: #49392F;
    }

    .btn-waste-details {
        background: #A9B78F;
        color: #49392F;
    }

    .btn-waste-delete {
        background: #C96B63;
        color: white;
    }

    .btn-waste-edit,
    .btn-waste-details,
    .btn-waste-delete {
        border: none;
        border-radius: 6px;
        padding: 7px 13px;
        text-decoration: none;
        font-size: 0.9rem;
        display: inline-block;
    }

    .btn-waste-edit:hover {
        background: #D5A747;
        color: #49392F;
    }

    .btn-waste-details:hover {
        background: #95A77B;
        color: #49392F;
    }

    .btn-waste-delete:hover {
        background: #B95750;
        color: white;
    }

    .waste-search {
        border: 1px solid #E4D8C8;
        border-radius: 9px;
        padding: 12px 16px;
    }

    .waste-count {
        background: #E8EBD9;
        color: #536447;
        padding: 5px 11px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .empty-waste {
        background: #FFFFFF;
        border: 1px dashed #C9BBA9;
        border-radius: 12px;
        padding: 35px;
        text-align: center;
        color: #74665B;
    }
</style>

<div class="waste-page">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h1 class="mb-1">Waste Records</h1>
            <p class="text-muted mb-0">
                Monitor and manage recorded bakery waste.
            </p>
        </div>

        <a asp-action="Create" class="btn-add-waste">
            + Add Waste Record
        </a>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <span class="waste-count">
            @wasteRecords.Count @(wasteRecords.Count == 1 ? "Waste Record" : "Waste Records")
        </span>
    </div>

    <div class="mb-4">
        <input type="text"
               id="searchInput"
               class="form-control waste-search"
               placeholder="Search by product, reason, or remarks..."
               autocomplete="off" />
    </div>

    <div class="row g-4" id="wasteRecordsBody">

        @foreach (var item in wasteRecords)
        {
            <div class="col-12 col-sm-6 col-lg-4 col-xl-3 waste-card-item"
                 data-search="@($"{item.Product?.ProductName} {item.ReasonForWaste} {item.Remarks}")">

                <div class="waste-card">

                    <div class="waste-card-header">
                        Waste Record
                    </div>

                    <div class="waste-card-body">

                        <h5 class="waste-product-name">
                            @(item.Product?.ProductName ?? "Unknown Product")
                        </h5>

                        <div class="waste-date mb-3">
                            @item.DateRecorded.ToString("MMMM dd, yyyy")
                        </div>

                        <div class="waste-info">
                            <span class="waste-label">Quantity Wasted:</span>
                            @item.QuantityWasted
                        </div>

                        <div class="waste-info">
                            <span class="waste-label">Reason:</span>
                            @(string.IsNullOrWhiteSpace(item.ReasonForWaste)
                                ? "Not specified"
                                : item.ReasonForWaste)
                        </div>

                        <div class="waste-info">
                            <span class="waste-label">Remarks:</span>
                            @(string.IsNullOrWhiteSpace(item.Remarks)
                                ? "No remarks"
                                : item.Remarks)
                        </div>

                        <hr />

                        <div class="waste-info">
                            <span class="waste-label">Unit Cost:</span>
                            @(item.Product == null
                                ? "N/A"
                                : $"₱{item.Product.UnitCost:N2}")
                        </div>

                        <div class="waste-info mb-1">
                            <span class="waste-label">Estimated Waste Cost:</span>
                        </div>

                        <div class="waste-cost">
                            ₱@item.EstimatedWasteCost.ToString("N2")
                        </div>

                        <hr />

                        <div class="waste-actions">

                            <a asp-action="Edit"
                               asp-route-id="@item.WasteRecordingId"
                               class="btn-waste-edit">
                                Edit
                            </a>

                            <a asp-action="Details"
                               asp-route-id="@item.WasteRecordingId"
                               class="btn-waste-details">
                                Details
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.WasteRecordingId"
                               class="btn-waste-delete">
                                Delete
                            </a>

                        </div>

                    </div>
                </div>
            </div>
        }

    </div>

    <div id="noResultsMessage" class="empty-waste mt-3" style="display:none;">
        <h5>No matching waste records found</h5>
        <p class="mb-0">Try searching with a different keyword.</p>
    </div>

    @if (!wasteRecords.Any())
    {
        <div class="empty-waste mt-3">
            <h5>No waste records available yet</h5>
            <p class="mb-0">Add your first waste record to get started.</p>
        </div>
    }

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const searchInput = document.getElementById("searchInput");
            const cards = document.querySelectorAll(".waste-card-item");
            const noResultsMessage = document.getElementById("noResultsMessage");

            searchInput.addEventListener("input", function () {

                const searchText = this.value.trim().toLowerCase();
                let visibleCount = 0;

                cards.forEach(function (card) {

                    const cardText = card.dataset.search.toLowerCase();
                    const matches = cardText.includes(searchText);

                    card.style.display = matches ? "" : "none";

                    if (matches) {
                        visibleCount++;
                    }
                });

                noResultsMessage.style.display =
                    visibleCount === 0 && cards.length > 0 ? "block" : "none";
            });
        });
    </script>
}
