
@model IEnumerable<CrumbCount2.Models.WasteRecording>

@{
    ViewData["Title"] = "Waste Records";
}

<h1>Waste Records</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Add Waste Record</a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Quantity Wasted</th>
            <th>Date Recorded</th>
            <th>Reason for Waste</th>
            <th>Remarks</th>
            <th>Product</th>
            <th>Unit Cost</th>
            <th>Estimated Waste Cost</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.QuantityWasted</td>

                <td>@item.DateRecorded.ToString("MM/dd/yyyy")</td>

                <td>@item.ReasonForWaste</td>

                <td>@item.Remarks</td>

                <td>@(item.Product?.ProductName ?? "Unknown Product")</td>

                <td>
                    @(item.Product?.UnitCost.ToString("C2") ?? "N/A")
                </td>

                <td>
                    @item.EstimatedWasteCost.ToString("C2")
                </td>

                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.WasteRecordingId">Edit</a> |

                    <a asp-action="Details"
                       asp-route-id="@item.WasteRecordingId">Details</a> |

                    <a asp-action="Delete"
                       asp-route-id="@item.WasteRecordingId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
