
@model IEnumerable<CrumbCount2.Models.Category>

@{
    ViewData["Title"] = "Categories";
    var categories = Model.ToList();
}

<style>
    .categories-page {
        color: #49392F;
    }

    .category-card {
        background: #FFFFFF;
        border: 1px solid #E4D8C8;
        border-radius: 14px;
        overflow: hidden;
        height: 100%;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .category-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 6px 18px rgba(73, 57, 47, 0.12);
    }

    .category-card-header {
        background: #A9B78F;
        padding: 14px 18px;
        color: #49392F;
        font-weight: 600;
    }

    .category-card-body {
        padding: 22px;
    }

    .category-name {
        font-size: 1.3rem;
        font-weight: 700;
        color: #49392F;
        margin-bottom: 12px;
    }

    .category-description {
        color: #74665B;
        min-height: 48px;
        margin-bottom: 18px;
    }

    .category-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
        margin-top: 18px;
    }

    .btn-create-category {
        background: #A9B78F;
        color: #49392F;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        text-decoration: none;
        display: inline-block;
    }

    .btn-create-category:hover {
        background: #95A77B;
        color: #49392F;
    }

    .btn-category-edit {
        background: #E5B85C;
        color: #49392F;
    }

    .btn-category-details {
        background: #A9B78F;
        color: #49392F;
    }

    .btn-category-delete {
        background: #C96B63;
        color: white;
    }

    .btn-category-edit,
    .btn-category-details,
    .btn-category-delete {
        border: none;
        border-radius: 6px;
        padding: 7px 13px;
        text-decoration: none;
        font-size: 0.9rem;
        display: inline-block;
    }

    .btn-category-edit:hover {
        background: #D5A747;
        color: #49392F;
    }

    .btn-category-details:hover {
        background: #95A77B;
        color: #49392F;
    }

    .btn-category-delete:hover {
        background: #B95750;
        color: white;
    }

    .category-search {
        border: 1px solid #E4D8C8;
        border-radius: 9px;
        padding: 12px 16px;
    }

    .category-count {
        background: #E8EBD9;
        color: #536447;
        padding: 5px 11px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .empty-categories {
        background: #FFFFFF;
        border: 1px dashed #C9BBA9;
        border-radius: 12px;
        padding: 35px;
        text-align: center;
        color: #74665B;
    }
</style>

<div class="categories-page">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h1 class="mb-1">Categories</h1>
            <p class="text-muted mb-0">
                Organize and manage your bakery product categories.
            </p>
        </div>

        @if (User.IsInRole("Administrator"))
        {
            <a asp-action="Create" class="btn-create-category">
                + Create New Category
            </a>
        }
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <span class="category-count">
            @categories.Count @(categories.Count == 1 ? "Category" : "Categories")
        </span>
    </div>

    <div class="mb-4">
        <input type="text"
               id="searchBox"
               class="form-control category-search"
               placeholder="Search categories by name or description..." />
    </div>

    <div class="row g-4" id="categoryRows">

        @foreach (var item in categories)
        {
            <div class="col-12 col-sm-6 col-lg-4 col-xl-3 category-card-item"
                 data-search="@($"{item.CategoryName} {item.Description}")">

                <div class="category-card">

                    <div class="category-card-header">
                        @item.CategoryName
                    </div>

                    <div class="category-card-body">

                        <h5 class="category-name">
                            @item.CategoryName
                        </h5>

                        <p class="category-description">
                            @(string.IsNullOrWhiteSpace(item.Description)
                                ? "No description available."
                                : item.Description)
                        </p>

                        <hr />

                        <div class="category-actions">

                            @if (User.IsInRole("Administrator"))
                            {
                                <a asp-action="Edit"
                                   asp-route-id="@item.CategoryId"
                                   class="btn-category-edit">
                                    Edit
                                </a>
                            }

                            <a asp-action="Details"
                               asp-route-id="@item.CategoryId"
                               class="btn-category-details">
                                Details
                            </a>

                            @if (User.IsInRole("Administrator"))
                            {
                                <a asp-action="Delete"
                                   asp-route-id="@item.CategoryId"
                                   class="btn-category-delete">
                                    Delete
                                </a>
                            }

                        </div>

                    </div>
                </div>
            </div>
        }

    </div>

    <div id="noCategoriesFound" class="empty-categories mt-3" style="display:none;">
        <h5>No categories found</h5>
        <p class="mb-0">Try searching with a different keyword.</p>
    </div>

    @if (!categories.Any())
    {
        <div class="empty-categories mt-3">
            <h5>No categories available yet</h5>
            <p class="mb-0">Create your first product category to get started.</p>
        </div>
    }

</div>

@section Scripts {
    <script>
        document.getElementById("searchBox").addEventListener("input", function () {

            const searchText = this.value.toLowerCase().trim();
            const cards = document.querySelectorAll(".category-card-item");

            let visibleCount = 0;

            cards.forEach(function (card) {

                const cardText = card.dataset.search.toLowerCase();
                const matches = cardText.includes(searchText);

                card.style.display = matches ? "" : "none";

                if (matches) {
                    visibleCount++;
                }
            });

            document.getElementById("noCategoriesFound").style.display =
                visibleCount === 0 && cards.length > 0 ? "block" : "none";
        });
    </script>
}
