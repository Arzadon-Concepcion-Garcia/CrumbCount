
@model CrumbCount2.Models.Disposition

@{
    ViewData["Title"] = "Delete Disposition";
}

<h2>Delete Disposition</h2>

<h4>Are you sure you want to delete this record?</h4>

<div class="card p-3 mb-3">
    <p><strong>Disposition ID:</strong> @Model.DispositionId</p>
    <p><strong>Product:</strong> @Model.WasteRecording?.Product?.ProductName</p>
    <p><strong>Quantity:</strong> @Model.Quantity</p>
    <p><strong>Type:</strong> @Model.DispositionType</p>
    <p><strong>Date:</strong> @Model.DispositionDate.ToString("MM/dd/yyyy")</p>
    <p><strong>Status:</strong> @Model.Status</p>
    <p><strong>Remarks:</strong> @Model.Remarks</p>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="DispositionId" />

    <button type="submit" class="btn btn-danger">
        Confirm Delete
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>
</form>
