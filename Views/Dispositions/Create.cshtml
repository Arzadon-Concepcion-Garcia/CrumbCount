
@model CrumbCount2.Models.Disposition

@{
    ViewData["Title"] = "Add Disposition";
}

<h1>Add Disposition</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group mb-3">
        <label asp-for="WasteRecordingId" class="control-label"></label>
        <select asp-for="WasteRecordingId"
                asp-items="ViewBag.WasteRecordingId"
                class="form-control">
            <option value="">-- Select Waste Recording --</option>
        </select>
        <span asp-validation-for="WasteRecordingId" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="DispositionType" class="control-label"></label>
        <select asp-for="DispositionType" class="form-control">
            <option value="">-- Select Disposition Type --</option>
            <option value="Staff Consumption">Staff Consumption</option>
            <option value="Donation">Donation</option>
            <option value="Approved Reuse">Approved Reuse</option>
            <option value="Disposal">Disposal</option>
        </select>
        <span asp-validation-for="DispositionType" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Quantity" class="control-label"></label>
        <input asp-for="Quantity" class="form-control" />
        <span asp-validation-for="Quantity" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="DispositionDate" class="control-label"></label>
        <input asp-for="DispositionDate" type="date" class="form-control" />
        <span asp-validation-for="DispositionDate" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Remarks" class="control-label"></label>
        <textarea asp-for="Remarks" class="form-control"></textarea>
        <span asp-validation-for="Remarks" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
