
@model CrumbCount2.Models.Disposition

@{
    ViewData["Title"] = "Add Disposition";
}

<h2>Add Disposition</h2>

<form asp-action="Create" method="post">

    <div class="form-group mb-3">
        <label asp-for="WasteRecordingId" class="form-label">
            Waste Recording
        </label>

        <select asp-for="WasteRecordingId"
                class="form-select"
                asp-items="ViewBag.WasteRecordingId">
            <option value="">-- Select Waste Recording --</option>
        </select>

        <span asp-validation-for="WasteRecordingId"
              class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="DispositionType" class="form-label"></label>

        <select asp-for="DispositionType" class="form-select">
            <option value="">-- Select Type --</option>
            <option value="Donation">Donation</option>
            <option value="Disposal">Disposal</option>
            <option value="Staff Consumption">Staff Consumption</option>
            <option value="Approved Reuse">Approved Reuse</option>
        </select>

        <span asp-validation-for="DispositionType"
              class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Quantity" class="form-label"></label>
        <input asp-for="Quantity" class="form-control" />
        <span asp-validation-for="Quantity"
              class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="DispositionDate" class="form-label"></label>
        <input asp-for="DispositionDate" type="date"
               class="form-control" />
        <span asp-validation-for="DispositionDate"
              class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Status" class="form-label"></label>

        <select asp-for="Status" class="form-select">
            <option value="Pending">Pending</option>
            <option value="Completed">Completed</option>
        </select>

        <span asp-validation-for="Status"
              class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Remarks" class="form-label"></label>
        <textarea asp-for="Remarks" class="form-control"></textarea>
        <span asp-validation-for="Remarks"
              class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Save Disposition
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>

</form>
